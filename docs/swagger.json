                    "type": {
                        "type": "string",
                        "nullable": true
                    },
                    "title": {
                        "type": "string",
                        "nullable": true
                    },
                    "status": {
                        "type": "integer",
                        "format": "int32",
                        "nullable": true
                    },
                    "detail": {
                        "type": "string",
                        "nullable": true
                    },
                    "instance": {
                        "type": "string",
                        "nullable": true
                    },
                    "errors": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "nullable": true
                    }
                },
                "additionalProperties": {}
            },
            "LoginRequest": {
                "required": [
                    "email",
                    "senha"
                ],
                "type": "object",
                "properties": {
                    "email": {
                        "minLength": 1,
                        "type": "string",
                        "format": "email"
                    },
                    "senha": {
                        "minLength": 1,
                        "type": "string"
                    }
                },
                "additionalProperties": false
            },
            "LoginResponse": {
                "type": "object",
                "properties": {
                    "token": {
                        "type": "string",
                        "nullable": true
                    },
                    "expiraEm": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "role": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "additionalProperties": false
            },
            "OcorrenciaRequest": {
                "required": [
                    "grupoAnimal",
                    "urgencia"
                ],
                "type": "object",
                "properties": {
                    "grupoAnimal": {
                        "minLength": 1,
                        "type": "string"
                    },
                    "urgencia": {
                        "minLength": 1,
                        "type": "string"
                    },
                    "latitude": {
                        "maximum": 90,
                        "minimum": -90,
                        "type": "number",
                        "format": "double"
                    },
                    "longitude": {
                        "maximum": 180,
                        "minimum": -180,
                        "type": "number",
                        "format": "double"
                    },
                    "data": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    }
                },
                "additionalProperties": false
            },
            "OcorrenciaResponse": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "usuarioId": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "data": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "grupoAnimal": {
                        "type": "string",
                        "nullable": true
                    },
                    "urgencia": {
                        "type": "string",
                        "nullable": true
                    },
                    "latitude": {
                        "type": "number",
                        "format": "double"
                    },
                    "longitude": {
                        "type": "number",
                        "format": "double"
                    },
                    "status": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "additionalProperties": false
            },
            "OcorrenciaResponsePaginaResponse": {
                "type": "object",
                "properties": {
                    "itens": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/OcorrenciaResponse"
                        },
                        "nullable": true
                    },
                    "pagina": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "tamanho": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "total": {
                        "type": "integer",
                        "format": "int32"
                    }
                },
                "additionalProperties": false
            },
            "ProblemDetails": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string",
                        "nullable": true
                    },
                    "title": {
                        "type": "string",
                        "nullable": true
                    },
                    "status": {
                        "type": "integer",
                        "format": "int32",
                        "nullable": true
                    },
                    "detail": {
                        "type": "string",
                        "nullable": true
                    },
                    "instance": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "additionalProperties": {}
            },
            "RegistrarRequest": {
                "required": [
                    "email",
                    "nome",
                    "senha"
                ],
                "type": "object",
                "properties": {
                    "nome": {
                        "maxLength": 150,
                        "minLength": 3,
                        "type": "string"
                    },
                    "email": {
                        "maxLength": 200,
                        "minLength": 0,
                        "type": "string",
                        "format": "email"
                    },
                    "senha": {
                        "maxLength": 100,
                        "minLength": 6,
                        "type": "string"
                    }
                },
                "additionalProperties": false
            },
            "TriagemRequest": {
                "required": [
                    "grupoAnimal"
                ],
                "type": "object",
                "properties": {
                    "grupoAnimal": {
                        "minLength": 1,
                        "type": "string"
                    },
                    "sintomas": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "nullable": true
                    },
                    "latitude": {
                        "maximum": 90,
                        "minimum": -90,
                        "type": "number",
