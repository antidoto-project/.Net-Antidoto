    "components": {
        "schemas": {
            "ContagemResponse": {
                "type": "object",
                "properties": {
                    "chave": {
                        "type": "string",
                        "nullable": true
                    },
                    "quantidade": {
                        "type": "integer",
                        "format": "int32"
                    }
                },
                "additionalProperties": false
            },
            "EstatisticasResponse": {
                "type": "object",
                "properties": {
                    "total": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "porGrupoAnimal": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ContagemResponse"
                        },
                        "nullable": true
                    },
                    "porMes": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ContagemResponse"
                        },
                        "nullable": true
                    }
                },
                "additionalProperties": false
            },
            "HttpValidationProblemDetails": {
                "type": "object",
